model AccountShare {
  id                        BigInt   @id @default(autoincrement())
  account_id                BigInt?
  virtual_account_id        BigInt?
  first_name                String
  last_name                 String
  personal_number_encrypted String?
  created_at                DateTime @default(now()) @db.Timestamptz(3)

  account         Account?        @relation(fields: [account_id], references: [id], onDelete: Cascade)
  virtual_account VirtualAccount? @relation(fields: [virtual_account_id], references: [id], onDelete: Cascade)

  @@index([account_id])
  @@index([virtual_account_id])
}
