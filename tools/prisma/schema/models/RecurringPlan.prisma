enum PlanDirection {
  IN
  OUT
}

enum PlanUnit {
  MONTH
  YEAR
}

model RecurringPlan {
  user_id    BigInt   @id
  created_at DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model RecurringPlanItem {
  id         BigInt         @id @default(autoincrement())
  user_id    BigInt
  direction  PlanDirection?
  name       String?        @db.VarChar(60)
  amount     Decimal?       @db.Decimal(18, 2)
  every      Int?
  unit       PlanUnit?
  last_date  DateTime?      @db.Date
  end_date   DateTime?      @db.Date
  series_key String?
  created_at DateTime       @default(now()) @db.Timestamptz(3)
  updated_at DateTime       @default(now()) @db.Timestamptz(3)

  user  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parts RecurringPlanItemPart[]

  @@unique([user_id, series_key])
  @@index([user_id])
}

model RecurringPlanItemPart {
  id         BigInt   @id @default(autoincrement())
  item_id    BigInt
  name       String   @db.VarChar(60)
  amount     Decimal  @db.Decimal(18, 2)
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(3)

  item RecurringPlanItem @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([item_id])
}
