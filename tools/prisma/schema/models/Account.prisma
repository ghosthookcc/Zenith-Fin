model Account {
  id BigInt @id @default(autoincrement())

  bank_aspsp_id      BigInt?
  enable_banking_uid String  @db.Uuid @unique

  iban     String?
  name     String?
  currency String

  identification_hash String?
  in_consent          Boolean @default(true)

  role              AccountRole?
  bank_account_type String?
  bank_product      String?

  balances_fetched_at    DateTime? @db.Timestamptz(3)
  transactions_synced_at DateTime? @db.Timestamptz(3)

  alias          AccountAlias?
  credit_account CreditAccount?
  shares         AccountShare[]

  manual_transactions_from ManualTransaction[] @relation("ManualTransactionFrom")
  manual_transactions_to   ManualTransaction[] @relation("ManualTransactionTo")

  balances           Balance[]
  transactions       Transaction[]
  bankConnection     BankConnection? @relation(fields: [bank_connection_id], references: [id])
  bank_connection_id BigInt?
}
