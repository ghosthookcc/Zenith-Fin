model Balance {
  id         BigInt @id @default(autoincrement())
  account_id BigInt

  amount       Decimal @db.Decimal(24, 8)
  currency     String  @db.VarChar(3)
  balance_type String
  name         String?

  last_committed_transaction String?

  last_change_date_time DateTime? @db.Timestamptz(3)
  reference_date        DateTime? @db.Date

  fetched_at DateTime @default(now()) @db.Timestamptz(3)

  account Account @relation(fields: [account_id], references: [id])

  @@unique([account_id, balance_type, currency])
}
