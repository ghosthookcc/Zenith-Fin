model Tag {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  key        String?  @unique
  name       String
  icon       String
  color      String   @db.VarChar(7)
  kind       TagKind  @default(SPENDING)
  keywords   String[] @default([])
  created_at DateTime @default(now()) @db.Timestamptz(3)

  user                 User?           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  corrections          TagCorrection[] @relation("CorrectionTag")
  replaced_corrections TagCorrection[] @relation("CorrectionReplacedTag")

  @@unique([user_id, name])
  @@index([user_id])
}

model TagCorrection {
  id                     BigInt   @id @default(autoincrement())
  user_id                BigInt
  credit_debit_indicator String
  own_transfer           Boolean  @default(false)
  signature              String
  description            String
  example                String
  tag_id                 BigInt
  replaced_tag_id        BigInt?
  created_at             DateTime @default(now()) @db.Timestamptz(3)
  updated_at             DateTime @default(now()) @db.Timestamptz(3)

  user         User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tag          Tag  @relation("CorrectionTag", fields: [tag_id], references: [id], onDelete: Cascade)
  replaced_tag Tag? @relation("CorrectionReplacedTag", fields: [replaced_tag_id], references: [id], onDelete: SetNull)

  @@unique([user_id, credit_debit_indicator, own_transfer, signature])
  @@index([tag_id])
}

enum TagKind {
  SPENDING
  INCOME
  TRANSFER
}

enum TagSource {
  RULE
  AI
  USER
  LEARNED
}
