enum AvanzaSyncState {
  OK
  AUTH_FAILED
  ERROR
  KEY_MISMATCH
}

model AvanzaCredential {
  user_id         BigInt   @id
  ciphertext      Bytes
  key_fingerprint String   @db.VarChar(64)
  updated_at      DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("avanza_credentials")
}

model AvanzaBalanceSnapshot {
  id           BigInt   @id @default(autoincrement())
  user_id      BigInt
  account_id   String   @db.VarChar(64)
  account_name String   @db.VarChar(200)
  account_type String?  @db.VarChar(64)
  total_value  Decimal  @db.Decimal(18, 2)
  currency     String   @db.VarChar(3)
  fetched_at   DateTime @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, fetched_at])
  @@map("avanza_balance_snapshots")
}

model AvanzaSyncStatus {
  user_id         BigInt           @id
  status          AvanzaSyncState?
  error_class     String?          @db.VarChar(100)
  last_attempt_at DateTime?        @db.Timestamptz(3)
  last_success_at DateTime?        @db.Timestamptz(3)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("avanza_sync_status")
}
