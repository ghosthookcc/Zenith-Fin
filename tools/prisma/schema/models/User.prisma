model User {
  id            BigInt   @id @default(autoincrement())
  full_name     String   @db.VarChar(70)
  email         String   @unique @db.VarChar(255)
  phone         String   @unique @db.VarChar(32)
  password_hash String   @db.VarChar(255)
  created_at    DateTime @default(now())

  sessions         Session[]
  status           UserStatus?
  bank_connections BankConnection[]
  tags             Tag[]
  tag_corrections  TagCorrection[]
  credit_accounts  CreditAccount[]
  expected_salaries ExpectedSalary[]
  recurring_rules  RecurringRule[]
  virtual_accounts VirtualAccount[]
  manual_transactions ManualTransaction[]
  partnerships_sent     Partnership[] @relation("PartnershipInviter")
  partnerships_received Partnership[] @relation("PartnershipInvitee")
  notifications         Notification[]

  @@index([email])
}

model UserStatus {
  user_id      BigInt   @id
  last_updated DateTime @updatedAt
  is_active    Boolean  @default(false)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
